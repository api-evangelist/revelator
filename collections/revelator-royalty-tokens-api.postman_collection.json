          "id": "1be42653-4e89-480d-a698-5e1f61f897f3",
          "name": "Mint a royalty token.",
          "request": {
            "name": "Mint a royalty token.",
            "description": {
              "content": "Mints a new ERC1155 royalty token for a track asset, with a total supply and a holder list (Web3 wallet addresses, friendly names, token balances) and an optional payout rate (1-100%, defaults to 100%). The enterprise smart-wallet address is automatically designated an Admin holder.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "royaltyTokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetType\": \"<string>\",\n  \"assetId\": \"<string>\",\n  \"totalSupply\": \"<integer>\",\n  \"smartContractStandard\": \"<string>\",\n  \"holders\": [\n    {\n      \"walletAddress\": \"<string>\",\n      \"friendlyName\": \"<string>\",\n      \"balance\": \"<integer>\"\n    },\n    {\n      \"walletAddress\": \"<string>\",\n      \"friendlyName\": \"<string>\",\n      \"balance\": \"<integer>\"\n    }\n  ],\n  \"payoutRate\": 100\n}",
